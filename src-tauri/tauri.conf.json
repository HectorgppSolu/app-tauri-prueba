{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "prueba2tauri",
  "version": "0.2.6",
  "identifier": "com-hector.prueba2tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
       
        "title": "prueba2tauri",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    
     "createUpdaterArtifacts":"v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
   "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/HectorgppSolu/app-tauri-prueba/releases/latest/download/latest.json"
      ],
